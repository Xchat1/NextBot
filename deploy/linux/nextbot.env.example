# Set this to the exact HTTPS origin clients use. Omit the trailing slash and default port.
NEXTBOT_ORIGIN=https://nextbot.example.internal
NEXTBOT_LISTEN=127.0.0.1:8787
# Set false for a P1 instance that permits tasks without independent review.
NEXTBOT_REQUIRE_REVIEW=true

# Paths must be usable by the service account. Verify both CLI versions on this host.
NEXTBOT_CODEX_HOME=
NEXTBOT_CODEX_VERSION=
NEXTBOT_CLAUDE_HOME=
NEXTBOT_CLAUDE_VERSION=

NEXTBOT_MANAGED_TESTS=false
NEXTBOT_CONTAINER_ENGINE=podman
